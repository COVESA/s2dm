// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "ES2025.Float16", "DOM"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared-ui/*": ["./src/shared-ui/*", "../shared-ui/*"],
      "@insights-ui/*": ["./src/insights-ui/*", "../insights-ui/*"],
      "@search-ui/*": ["./src/search-ui/*", "../search-ui/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "exclude": [".docusaurus", "build"]
}
